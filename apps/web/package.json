{
  "name": "hubris-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run generate:material-icons && vite build",
    "preview": "vite preview",
    "check": "tsc -p ./tsconfig.app.json && tsc -p ./tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:smoke": "HUBRIS_VITEST_SMOKE=true vitest run src/lib/monaco.runtime.smoke.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config playwright.e2e-smoke.config.ts",
    "test": "bun run test:unit",
    "test:all": "bun run test:unit && bun run test:smoke && bun run test:e2e",
    "generate:contracts:rest": "bunx openapi-typescript src/lib/contracts/openapi.generated.json -o src/lib/contracts/rest.generated.ts && prettier --write src/lib/contracts/openapi.generated.json src/lib/contracts/rest.generated.ts src/lib/contracts/sse.generated.ts src/lib/contracts/ws.generated.ts",
    "generate:monaco-languages": "bun run scripts/generate-monaco-language-registry.ts",
    "generate:desktop-runtime": "bun run scripts/generate-desktop-runtime-config.ts > src/lib/desktopRuntimeConfig.generated.ts && prettier --write src/lib/desktopRuntimeConfig.generated.ts",
    "generate:theme-defaults": "bun run scripts/generate-theme-defaults.ts > src/lib/theme/defaults.generated.css && prettier --write src/lib/theme/defaults.generated.css",
    "generate:material-icons": "bun run scripts/generate-material-icon-theme.ts && prettier --write src/lib/materialIconTheme.generated.ts"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.53",
    "@assistant-ui/react": "^0.12.25",
    "@copilotkit/react-core": "^1.57.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.2",
    "lucide-react": "^1.7.0",
    "monaco-editor": "^0.55.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unique-names-generator": "^4.7.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.55.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/culori": "^4.0.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.4.23",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "material-icon-theme": "5.33.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.2"
  }
}
