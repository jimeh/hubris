{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "generate:contracts:rest": "bunx openapi-typescript src/lib/contracts/openapi.generated.json -o src/lib/contracts/rest.generated.ts && prettier --write src/lib/contracts/openapi.generated.json src/lib/contracts/rest.generated.ts src/lib/contracts/sse.generated.ts src/lib/contracts/ws.generated.ts",
    "generate:theme-defaults": "bun run scripts/generate-theme-defaults.ts > src/lib/theme/defaults.generated.css && prettier --write src/lib/theme/defaults.generated.css"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^0.561.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/culori": "^4.0.1",
    "@types/node": "^25.3.3",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "eslint": "^10.0.2",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "svelte-dnd-action": "^0.9.69",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "culori": "^4.0.2",
    "unique-names-generator": "^4.7.1"
  }
}
