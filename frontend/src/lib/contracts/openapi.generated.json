  "components": {
    "schemas": {
      "AddProjectRequest": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string"
          }
        }
      },
      "AppearanceSettings": {
        "type": "object",
        "properties": {
          "colorScheme": {
            "$ref": "#/components/schemas/ColorScheme"
          },
          "darkTheme": {
            "type": "string"
          },
          "lightTheme": {
            "type": "string"
          }
        }
      },
      "AppearanceSettingsPatch": {
        "type": "object",
        "properties": {
          "colorScheme": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ColorScheme"
              }
            ]
          },
          "darkTheme": {
            "type": ["string", "null"]
          },
          "lightTheme": {
            "type": ["string", "null"]
          }
        }
      },
      "ClientControlMessage": {
        "oneOf": [
          {
            "type": "object",
            "required": ["cols", "rows", "visible", "type"],
            "properties": {
              "cols": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "rows": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "enum": ["resize"]
              },
              "visible": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "ColorScheme": {
        "type": "string",
        "enum": ["auto", "light", "dark"]
      },
      "CreateTabRequest": {
        "type": "object",
        "required": ["worktree_id"],
        "properties": {
          "worktree_id": {
            "type": "string"
          }
        }
      },
      "CreateWorktreeRequest": {
        "type": "object",
        "required": ["branch"],
        "properties": {
          "branch": {
            "type": "string"
          },
          "source_ref": {
            "type": ["string", "null"]
          },
          "start_point": {
            "type": ["string", "null"]
          }
        }
      },
      "DirEntry": {
        "type": "object",
        "required": ["name", "is_git_repo"],
        "properties": {
          "is_git_repo": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "GitCommitSummary": {
        "type": "object",
        "required": ["id", "short_id", "summary"],
        "properties": {
          "id": {
            "type": "string"
          },
          "short_id": {
