#!/usr/bin/env bash
#MISE description="Run the Electron desktop app in dev mode"
set -euo pipefail

TMP_DIR="${HUBRIS_DEV_TMP:-$(pwd)/tmp}"
mkdir -p "$TMP_DIR"

DEV_ID="${HUBRIS_DEV_ID:-$(od -An -tx1 -N4 /dev/urandom | tr -d ' \n')}"
BOOTSTRAP_TOKEN="${HUBRIS_DESKTOP_BOOTSTRAP_TOKEN:-$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')}"
SESSION_TOKEN="${HUBRIS_DESKTOP_SESSION_TOKEN:-$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')}"
export HUBRIS_DEV_ID="$DEV_ID"
export HUBRIS_DEV_TMP="$TMP_DIR"
export HUBRIS_DESKTOP_BOOTSTRAP_TOKEN="$BOOTSTRAP_TOKEN"
export HUBRIS_DESKTOP_SESSION_TOKEN="$SESSION_TOKEN"

DEV_STACK_PID=""

cleanup() {
  if [[ -n "$DEV_STACK_PID" ]] && kill -0 "$DEV_STACK_PID" 2>/dev/null; then
    kill "$DEV_STACK_PID" 2>/dev/null || true
    wait "$DEV_STACK_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

./.mise/tasks/dev dev:web &
DEV_STACK_PID=$!
bun run --filter hubris-desktop dev "$@"
