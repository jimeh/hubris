#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 ]]; then
  echo "usage: build-desktop-target <platform> <arch> <runtime-target>" >&2
  exit 1
fi

PLATFORM=$1
ARCH=$2
RUNTIME_TARGET=$3

case "$PLATFORM:$ARCH" in
  darwin:arm64|darwin:x64)
    ;;
  *)
    echo "unsupported desktop target: $PLATFORM/$ARCH" >&2
    exit 1
    ;;
esac

mise run build:web
bash .mise/tasks/build-rust-target \
  hubris-desktop-runtime \
  "$RUNTIME_TARGET"

RUNTIME_PATH="$(pwd)/target/$RUNTIME_TARGET/release/hubris-desktop-runtime"
if [[ ! -f "$RUNTIME_PATH" ]]; then
  echo "packaged runtime not found at $RUNTIME_PATH" >&2
  exit 1
fi

# Remove any previous output for this target so stale artifacts cannot mask
# a packaging run that exits 0 without producing anything (Electron Packager
# has done exactly that on Node 24.16+ during template extraction).
rm -rf \
  "$(pwd)/dist/Hubris-$PLATFORM-$ARCH" \
  "$(pwd)/dist/make/zip/$PLATFORM/$ARCH"

export HUBRIS_DESKTOP_RUNTIME_PATH="$RUNTIME_PATH"
bun run --filter hubris-desktop make \
  --platform "$PLATFORM" \
  --arch "$ARCH" \
  --targets "@electron-forge/maker-zip"

bash scripts/verify-desktop-package.sh "$PLATFORM" "$ARCH"
