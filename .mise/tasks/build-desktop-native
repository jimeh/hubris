#!/usr/bin/env bash
set -euo pipefail

host_platform=$(uname -s)
host_arch=$(uname -m)

case "$host_platform" in
  Darwin)
    platform=darwin
    ;;
  *)
    echo "build:desktop only supports native macOS hosts; use build:desktop:macos-* for cross-builds" >&2
    exit 1
    ;;
esac

case "$host_arch" in
  arm64|aarch64)
    arch=arm64
    ;;
  x86_64)
    arch=x64
    ;;
  *)
    echo "unsupported host architecture: $host_arch" >&2
    exit 1
    ;;
esac

case "$platform:$arch" in
  darwin:arm64)
    runtime_target=aarch64-apple-darwin
    ;;
  darwin:x64)
    runtime_target=x86_64-apple-darwin
    ;;
esac

bash .mise/tasks/build-desktop-target "$platform" "$arch" "$runtime_target"
