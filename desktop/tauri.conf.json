{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hubris",
  "version": "0.1.0",
  "identifier": "dev.hubris.desktop",
  "build": {
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "cd frontend && bun run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../frontend/dist": "dist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
